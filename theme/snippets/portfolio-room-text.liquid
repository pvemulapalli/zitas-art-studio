{% doc %}
  Portfolio room editorial body: work title and reflection only.
  Room identity and series actions are rendered by the room section.

  @param {string} work_title - Italic work title
  @param {string} reflection - Rich text HTML (already sanitized by Shopify)
  @param {string} [stack_class] - Extra class on the stack
{% enddoc %}

<div class="portfolio-room__text {{ stack_class }}">
  {%- if work_title != blank -%}
    <p class="portfolio-room__work"><em>{{ work_title | escape }}</em></p>
  {%- endif -%}

  {%- if reflection != blank -%}
    <blockquote class="portfolio-room__reflection">{{ reflection }}</blockquote>
  {%- endif -%}
</div>
