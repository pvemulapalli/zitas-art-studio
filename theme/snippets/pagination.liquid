{% doc %}
  Renders quiet Previous / Next pagination as real links, so it works without JavaScript and
  stays crawlable. Renders nothing when everything fits on one page.

  @param {object} paginate - The paginate object from a {% paginate %} block

  @example
  {% render 'pagination', paginate: paginate %}
{% enddoc %}

{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'plp.pagination' | t }}">
    <span class="pagination__side">
      {%- if paginate.previous -%}
        <a class="label-link pagination__link" href="{{ paginate.previous.url }}" rel="prev">
          {%- render 'icon', name: 'arrow-left', size: 16, class: 'label-link__arrow pagination__arrow-back' -%}
          {{- 'plp.previous' | t -}}
        </a>
      {%- endif -%}
    </span>

    <span class="pagination__status">
      {{- 'plp.page_of' | t: current: paginate.current_page, total: paginate.pages -}}
    </span>

    <span class="pagination__side pagination__side--end">
      {%- if paginate.next -%}
        <a class="label-link pagination__link" href="{{ paginate.next.url }}" rel="next">
          {{- 'plp.next' | t -}}
          {%- render 'icon', name: 'arrow-right', size: 16, class: 'label-link__arrow' -%}
        </a>
      {%- endif -%}
    </span>
  </nav>
{%- endif -%}

{% stylesheet %}
  .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    margin-block-start: clamp(64px, 6vw, 96px);
  }

  .pagination__side--end {
    justify-self: end;
  }

  .pagination__status {
    font-size: 16px;
    color: var(--color-text-meta);
  }

  .pagination .label-link:hover .pagination__arrow-back {
    transform: translateX(-4px);
  }

  @media (max-width: 749px) {
    .pagination {
      gap: 12px;
      margin-block-start: 56px;
    }

    .pagination__status {
      font-size: 15px;
    }
  }
{% endstylesheet %}
