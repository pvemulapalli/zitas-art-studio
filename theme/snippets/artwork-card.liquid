{% doc %}
  Renders the shared V2 artwork card: matted image, optional room view, and caption
  (series, title, price or Sold, dimensions). Used by the homepage and the collection page.

  The caption is the card's only link; it stretches over the whole card, so the plate is
  clickable too. The room view is the product's second image when present. It cross-fades
  in on hover/focus. With room_swipe, touch visitors swipe to it instead: the link then
  stops covering the plate so the swipe region is never nested inside the link, and the
  section must load zita-artwork-card.js. Leave room_swipe off inside horizontally
  scrolling rows, where a nested swipe would compete with the row.

  @param {product} product - Artwork product
  @param {boolean} [room_swipe] - Enables the touch swipe to the room view
  @param {string} [series] - Clean series name to show above the title
  @param {string} [sizes] - sizes attribute for the artwork image
  @param {string} [loading] - 'lazy' (default) or 'eager'
  @param {string} [fetchpriority] - 'high' for the first artwork on a page
  @param {string} [heading_tag] - Title element (default h3)

  @example
  {% render 'artwork-card', product: product, sizes: '(min-width: 750px) 25vw, 78vw' %}
{% enddoc %}

{%- liquid
  assign primary_image = nil
  assign room_image = nil
  for media in product.media
    if media.media_type == 'image'
      if primary_image == nil
        assign primary_image = media.preview_image
      else
        assign room_image = media.preview_image
        break
      endif
    endif
  endfor
  if primary_image == nil
    assign primary_image = product.featured_image
  endif

  assign title_tag = heading_tag | default: 'h3'
  assign artwork_alt = primary_image.alt | default: product.title
  assign region_label = 'artwork.artwork_and_room' | t: title: product.title

  assign card_classes = 'artwork-card'
  if room_image and room_swipe
    assign card_classes = card_classes | append: ' artwork-card--swipe'
  endif

  assign quick_variant = product.selected_or_first_available_variant
  assign quick_add_direct = false
  if product.available and product.has_only_default_variant and quick_variant.available
    assign quick_add_direct = true
  endif
-%}

{%- capture dimensions -%}
  {%- render 'artwork-dimensions', product: product -%}
{%- endcapture -%}

<div class="{{ card_classes }}">
  <div class="artwork-card__media">
    {%- render 'artwork-plate',
      image: primary_image,
      room_image: room_image,
      room_swipe: room_swipe,
      region_label: region_label,
      alt: artwork_alt,
      sizes: sizes,
      loading: loading,
      fetchpriority: fetchpriority
    -%}

    {%- if product.available -%}
      {%- if quick_add_direct -%}
        <button
          type="button"
          class="artwork-card__quick-add"
          data-quick-add
          data-variant-id="{{ quick_variant.id }}"
          data-product-title="{{ product.title | escape }}"
          data-add-label="{{ 'artwork.quick_add' | t | escape }}"
          data-adding-label="{{ 'artwork.quick_add_adding' | t | escape }}"
          data-added-label="{{ 'artwork.quick_add_added' | t | escape }}"
          data-error-label="{{ 'artwork.quick_add_error' | t | escape }}"
          aria-label="{{ 'artwork.quick_add_label' | t: title: product.title | escape }}"
        >
          <span class="artwork-card__quick-add-icon" aria-hidden="true">
            {%- render 'icon', name: 'shopping-bag-plus', size: 18 -%}
          </span>
          <span class="artwork-card__quick-add-text">{{ 'artwork.quick_add' | t }}</span>
        </button>
      {%- else -%}
        <a
          class="artwork-card__quick-add"
          href="{{ product.url }}"
          data-quick-add-options
          aria-label="{{ 'artwork.quick_add_options_label' | t: title: product.title | escape }}"
        >
          <span class="artwork-card__quick-add-icon" aria-hidden="true">
            {%- render 'icon', name: 'shopping-bag-plus', size: 18 -%}
          </span>
          <span class="artwork-card__quick-add-text">{{ 'artwork.quick_add' | t }}</span>
        </a>
      {%- endif -%}
    {%- endif -%}
  </div>

  <a class="artwork-card__link" href="{{ product.url }}">
    <div class="artwork-card__caption">
      {%- if series != blank -%}
        <span class="artwork-card__series">{{ series | escape }}</span>
      {%- endif -%}

      <div class="artwork-card__row">
        <{{ title_tag }} class="artwork-card__title">{{ product.title | escape }}</{{ title_tag }}>

        {%- if product.available -%}
          <span class="artwork-card__price">
            {%- if product.price_varies -%}
              {%- assign price_min = product.price_min | money_without_trailing_zeros -%}
              {{ 'artwork.price_from' | t: price: price_min }}
            {%- else -%}
              {{ product.price | money_without_trailing_zeros }}
            {%- endif -%}
          </span>
        {%- else -%}
          <span class="artwork-card__sold">{{ 'artwork.sold' | t }}</span>
        {%- endif -%}
      </div>

      {%- if dimensions != blank or series != blank -%}
        <span class="artwork-card__meta">
          {%- if series != blank -%}
            <span class="artwork-card__meta-series">
              {{- series | escape -}}
              {%- if dimensions != blank %} · {% endif -%}
            </span>
          {%- endif -%}
          {{- dimensions -}}
        </span>
      {%- endif -%}
    </div>
  </a>
  <p class="visually-hidden" aria-live="polite" data-quick-add-live></p>
</div>

{% stylesheet %}
  .artwork-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    color: var(--color-text);
  }

  .artwork-card__media {
    position: relative;
    min-width: 0;
  }

  .artwork-card__quick-add {
    position: absolute;
    inset-block-end: 12px;
    inset-inline-end: 12px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgb(248 248 246 / 0.96);
    color: var(--color-ink);
    box-shadow: 0 1px 2px rgb(13 20 26 / 0.08), 0 10px 24px -16px rgb(13 20 26 / 0.35);
    text-decoration: none;
    cursor: pointer;
    overflow: hidden;
    opacity: 0;
    transform: translateY(4px);
    pointer-events: none;
    transition:
      width var(--duration-base) var(--ease-pour),
      padding var(--duration-base) var(--ease-pour),
      gap var(--duration-base) var(--ease-pour),
      opacity var(--duration-fast) var(--ease-pour),
      transform var(--duration-fast) var(--ease-pour),
      background-color var(--duration-fast) var(--ease-pour),
      color var(--duration-fast) var(--ease-pour);
  }

  .artwork-card__quick-add-icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
  }

  .artwork-card__quick-add-text {
    flex: none;
    max-width: 0;
    margin: 0;
    overflow: hidden;
    font-family: var(--font-display);
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    transition:
      max-width var(--duration-base) var(--ease-pour),
      opacity var(--duration-fast) var(--ease-pour),
      padding var(--duration-base) var(--ease-pour);
  }

  .artwork-card:hover .artwork-card__quick-add,
  .artwork-card:focus-within .artwork-card__quick-add,
  .artwork-card__quick-add:focus-visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .artwork-card__quick-add:hover,
  .artwork-card__quick-add:focus-visible,
  .artwork-card__quick-add.is-expanded {
    width: auto;
    padding-inline-end: 14px;
    gap: 0;
  }

  .artwork-card__quick-add:hover .artwork-card__quick-add-text,
  .artwork-card__quick-add:focus-visible .artwork-card__quick-add-text,
  .artwork-card__quick-add.is-expanded .artwork-card__quick-add-text {
    max-width: 4.5rem;
    padding-inline-end: 2px;
    opacity: 1;
  }

  .artwork-card__quick-add:hover,
  .artwork-card__quick-add:focus-visible {
    background: var(--color-gesso);
    color: var(--color-teal);
  }

  .artwork-card__quick-add:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .artwork-card__quick-add.is-busy,
  .artwork-card__quick-add.is-added {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .artwork-card__quick-add.is-added {
    color: var(--color-available);
  }

  @media (hover: none) {
    .artwork-card__quick-add {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .artwork-card__quick-add,
    .artwork-card__quick-add-text {
      transition: none;
    }
  }

  .artwork-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .artwork-card__link:hover {
    color: inherit;
  }

  /* Stretches the link over the whole card, plate included. Quick Add sits above (z-index 2). */
  .artwork-card__link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .artwork-card__link:focus-visible {
    outline: none;
  }

  .artwork-card__link:focus-visible::before {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .artwork-card__caption {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding-block-start: 16px;
  }

  .artwork-card__series {
    font-family: var(--font-display);
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-copper);
  }

  .artwork-card__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }

  .artwork-card__title {
    margin: 0;
    font-size: 19px;
    line-height: 1.25;
    color: var(--color-ink);
    transition: color var(--duration-fast) var(--ease-pour);
  }

  .artwork-card:hover .artwork-card__title,
  .artwork-card:focus-within .artwork-card__title {
    color: var(--color-teal);
  }

  .artwork-card__price {
    flex: none;
    font-size: 17px;
    line-height: 1.4;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .artwork-card__sold {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 7px;
    font-family: var(--font-display);
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .artwork-card__sold::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-sold);
  }

  .artwork-card__meta {
    font-size: 15px;
    line-height: 1.45;
    color: var(--color-text-meta);
  }

  .artwork-card__meta-series {
    display: none;
  }

  @media (hover: hover) {
    .artwork-card:hover .artwork-plate--has-room .artwork-plate__room,
    .artwork-card:focus-within .artwork-plate--has-room .artwork-plate__room {
      opacity: 1;
    }

    .artwork-card:hover .artwork-plate--has-room .artwork-plate__frame,
    .artwork-card:focus-within .artwork-plate--has-room .artwork-plate__frame {
      opacity: 0;
    }
  }

  /* Touch screens swipe the plate, so the link stops covering it and the caption alone is the link. */
  @media (hover: none) {
    .artwork-card--swipe .artwork-card__link::before {
      display: none;
    }

    .artwork-card--swipe .artwork-card__link {
      position: relative;
    }

    .artwork-card--swipe .artwork-card__link:focus-visible {
      outline: 2px solid var(--color-focus);
      outline-offset: 3px;
    }

    .artwork-card--swipe .artwork-card__quick-add {
      inset-block-end: 18px;
    }
  }

  @media (max-width: 749px) {
    .artwork-card__caption {
      gap: 4px;
      min-height: 44px;
      padding-block-start: 12px;
    }

    .artwork-card__series {
      display: none;
    }

    .artwork-card__meta-series {
      display: inline;
    }

    .artwork-card__title {
      font-size: 18px;
    }

    .artwork-card__sold::before {
      width: 7px;
      height: 7px;
    }
  }
{% endstylesheet %}
