{%- liquid
  assign display_font = settings.type_display_font
  assign body_font = settings.type_body_font
  assign body_font_italic = body_font | font_modify: 'style', 'italic'
  assign body_font_medium = body_font | font_modify: 'weight', '500'
  assign body_font_semibold = body_font | font_modify: 'weight', '600'
-%}

{% style %}
  {% # Marcellus ships a single 400 weight; Mulish loads 400, 400 italic, 500 and 600. %}
  {{ display_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_font_italic | font_face: font_display: 'swap' }}
  {{ body_font_medium | font_face: font_display: 'swap' }}
  {{ body_font_semibold | font_face: font_display: 'swap' }}

  :root {
    --font-display: {{ display_font.family }}, {{ display_font.fallback_families }};
    --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};

    /* Read by critical.css and the Skeleton templates (including the password layout, which doesn't load zita-base.css). */
    --font-primary--family: var(--font-body);
    --page-margin: clamp(20px, 3.4vw, 56px);
    --page-width: calc(1560px + 2 * var(--page-margin));
    --color-background: #f8f8f6;
    --color-foreground: #1f2a33;
    --style-border-radius-inputs: 0;
  }
{% endstyle %}
