{% doc %}
  Renders a decorative outline icon (1.25px stroke). Icon geometry is from Lucide (ISC licence).

  @param {string} name - search | instagram | shopping-bag | chevron-down | arrow-right | arrow-left | pause | play | sliders-horizontal | x
  @param {number} [size] - Rendered width and height in pixels (default 20)
  @param {string} [class] - Extra class names

  @example
  {% render 'icon', name: 'arrow-right', size: 16, class: 'label-link__arrow' %}
{% enddoc %}

{%- assign icon_size = size | default: 20 -%}
<svg
  class="icon icon--{{ name }} {{ class }}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
    {%- when 'instagram' -%}
      <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
    {%- when 'shopping-bag' -%}
      <path d="M16 10a4 4 0 0 1-8 0"/><path d="M3.103 6.034h17.794"/><path d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z"/>
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'arrow-right' -%}
      <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
    {%- when 'arrow-left' -%}
      <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
    {%- when 'pause' -%}
      <rect x="14" y="4" width="4" height="16" rx="1"/><rect x="6" y="4" width="4" height="16" rx="1"/>
    {%- when 'play' -%}
      <polygon points="6 3 20 12 6 21 6 3"/>
    {%- when 'sliders-horizontal' -%}
      <line x1="21" x2="14" y1="4" y2="4"/><line x1="10" x2="3" y1="4" y2="4"/><line x1="21" x2="12" y1="12" y2="12"/><line x1="8" x2="3" y1="12" y2="12"/><line x1="21" x2="16" y1="20" y2="20"/><line x1="12" x2="3" y1="20" y2="20"/><line x1="14" x2="14" y1="2" y2="6"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="16" x2="16" y1="18" y2="22"/>
    {%- when 'x' -%}
      <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
  {%- endcase -%}
</svg>
