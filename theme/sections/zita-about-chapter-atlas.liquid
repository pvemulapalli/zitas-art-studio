{{ 'zita-about-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign surface = section.settings.surface | default: 'vaayu_mist'
  assign plates = section.blocks | where: 'type', 'plate'
  assign plate_count = 0
  for block in plates
    if block.settings.image != blank or request.design_mode
      assign plate_count = plate_count | plus: 1
    endif
  endfor
-%}

<section
  class="about-section about-atlas full-width about-atlas--count-{{ plate_count }}"
  {% render 'about-surface', surface: surface, fallback: 'vaayu_mist' %}
  {% if section.settings.title != blank %}aria-labelledby="About-ch4-title-{{ section.id }}"{% endif %}
>
  <div class="about-shell">
    <div class="about-atlas__header" data-about-reveal>
      <div class="about-atlas__eyebrow-row">
        {%- if section.settings.numeral != blank -%}
          <span class="about-numeral" aria-hidden="true">{{ section.settings.numeral | escape }}</span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="About-ch4-title-{{ section.id }}" class="about-atlas__heading">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.statement != blank -%}
        <p class="about-atlas__statement">{{ section.settings.statement | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.intro != blank -%}
      <p class="about-atlas__intro" data-about-reveal>{{ section.settings.intro | escape }}</p>
    {%- endif -%}

    {%- if plates.size > 0 -%}
      {%- liquid
        assign stagger_index = 0
        assign fourth_block = false
      -%}

      <div class="about-grid about-atlas__plates">
        {%- for block in plates -%}
          {%- if block.settings.image == blank and request.design_mode == false -%}
            {%- continue -%}
          {%- endif -%}
          {%- assign stagger_index = stagger_index | plus: 1 -%}
          {%- if stagger_index > 3 -%}
            {%- assign fourth_block = block -%}
            {%- break -%}
          {%- endif -%}

          {%- liquid
            case stagger_index
              when 1
                assign plate_mod = 'about-atlas__plate--a'
                assign aspect_class = 'about-plate about-plate--3x5'
                assign phrase_class = ''
              when 2
                assign plate_mod = 'about-atlas__plate--b'
                assign aspect_class = 'about-plate about-plate--1x1'
                assign phrase_class = ''
              else
                assign plate_mod = 'about-atlas__plate--c'
                assign aspect_class = 'about-plate about-plate--pad-10'
                assign phrase_class = 'about-figure__phrase-text--sm'
            endcase
          -%}

          <figure
            class="about-figure about-figure--phrase {{ plate_mod }}"
            data-about-reveal
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              <div class="{{ aspect_class }}">
                {%- render 'responsive-image',
                  image: block.settings.image,
                  alt: block.settings.alt,
                  sizes: '(min-width: 750px) 30vw, 100vw',
                  widths: '360, 480, 720, 960, 1200',
                  class: 'about-plate__image'
                -%}
              </div>
            {%- elsif request.design_mode -%}
              <div class="{{ aspect_class }}">
                <span class="editor-placeholder">{{ 'about.editor.add_artwork' | t }}</span>
              </div>
            {%- endif -%}
            {%- if block.settings.phrase != blank or block.settings.label != blank -%}
              <figcaption class="about-figure__phrase">
                {%- if block.settings.phrase != blank -%}
                  <span class="about-figure__phrase-text {{ phrase_class }}">{{ block.settings.phrase | escape }}</span>
                {%- endif -%}
                {%- if block.settings.label != blank -%}
                  <span class="about-figure__label">{{ block.settings.label | escape }}</span>
                {%- endif -%}
              </figcaption>
            {%- endif -%}
          </figure>
        {%- endfor -%}
      </div>

      {%- if section.settings.mid_para_1 != blank or section.settings.mid_para_2 != blank or fourth_block != nil -%}
        <div class="about-grid about-atlas__mid">
          <div class="about-atlas__mid-copy" data-about-reveal>
            {%- if section.settings.mid_para_1 != blank -%}
              <p class="about-body">{{ section.settings.mid_para_1 | escape }}</p>
            {%- endif -%}
            {%- if section.settings.mid_para_2 != blank -%}
              <p class="about-body">{{ section.settings.mid_para_2 | escape }}</p>
            {%- endif -%}
          </div>

          {%- if fourth_block -%}
            <figure
              class="about-figure about-figure--phrase about-atlas__plate--d"
              data-about-reveal
              {{ fourth_block.shopify_attributes }}
            >
              {%- if fourth_block.settings.image != blank -%}
                <div class="about-plate about-plate--5x4">
                  {%- render 'responsive-image',
                    image: fourth_block.settings.image,
                    alt: fourth_block.settings.alt,
                    sizes: '(min-width: 750px) 48vw, 100vw',
                    widths: '480, 720, 960, 1200',
                    class: 'about-plate__image'
                  -%}
                </div>
              {%- elsif request.design_mode -%}
                <div class="about-plate about-plate--5x4">
                  <span class="editor-placeholder">{{ 'about.editor.add_artwork' | t }}</span>
                </div>
              {%- endif -%}
              {%- if fourth_block.settings.phrase != blank or fourth_block.settings.label != blank -%}
                <figcaption class="about-figure__phrase">
                  {%- if fourth_block.settings.phrase != blank -%}
                    <span class="about-figure__phrase-text">{{ fourth_block.settings.phrase | escape }}</span>
                  {%- endif -%}
                  {%- if fourth_block.settings.label != blank -%}
                    <span class="about-figure__label">{{ fourth_block.settings.label | escape }}</span>
                  {%- endif -%}
                </figcaption>
              {%- endif -%}
            </figure>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.close_pull != blank -%}
      <p class="about-pull about-atlas__close-pull" data-about-reveal>{{ section.settings.close_pull | escape }}</p>
    {%- endif -%}
    {%- if section.settings.close_body != blank -%}
      <p class="about-body about-atlas__close-body" data-about-reveal>{{ section.settings.close_body | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About chapter · atlas",
  "tag": "section",
  "class": "section-about-atlas",
  "enabled_on": {
    "templates": ["page"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "surface",
      "label": "Surface",
      "info": "Avoid two dark sections next to each other. Sand once per page. Phrase-to-painting pairings are provisional until confirmed.",
      "options": [
        { "value": "gesso", "label": "Gesso (light)" },
        { "value": "vaayu_mist", "label": "Vaayu mist (light blue)" },
        { "value": "stone_mist", "label": "Stone mist (light grey)" },
        { "value": "sand", "label": "Sand (warm light)" },
        { "value": "deep_teal", "label": "Deep teal (dark)" },
        { "value": "ink", "label": "Ink (dark)" },
        { "value": "night", "label": "Night (darkest)" }
      ],
      "default": "vaayu_mist"
    },
    {
      "type": "text",
      "id": "numeral",
      "label": "Chapter numeral",
      "default": "04"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Chapter title (eyebrow)",
      "default": "Inspired by nature"
    },
    {
      "type": "textarea",
      "id": "statement",
      "label": "Statement",
      "default": "Nature is at the heart of much of my abstract work."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro paragraph",
      "default": "I find inspiration in the vastness of the sky, the depth of the ocean, the stillness of mountains, the movement of air, and the freshness of spring."
    },
    {
      "type": "textarea",
      "id": "mid_para_1",
      "label": "Mid paragraph 1",
      "default": "These elements often find their way into my paintings, not necessarily as literal landscapes, but as expressions of how I experience the world around me."
    },
    {
      "type": "textarea",
      "id": "mid_para_2",
      "label": "Mid paragraph 2",
      "default": "Some works emerge as bold florals, fiery orange skies, or restless ocean tides. Others reflect quieter moments — open stretches of sand, distant horizons, and the gentle meeting of earth and sky."
    },
    {
      "type": "textarea",
      "id": "close_pull",
      "label": "Closing pull",
      "default": "My paintings carry different emotions, just as we do."
    },
    {
      "type": "textarea",
      "id": "close_body",
      "label": "Closing sentence",
      "default": "Some are vibrant and full of energy; others invite stillness and reflection."
    }
  ],
  "blocks": [
    {
      "type": "plate",
      "name": "Atlas plate",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Artwork"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        },
        {
          "type": "text",
          "id": "phrase",
          "label": "Phrase",
          "info": "Provisional pairing until Ranjeeta confirms."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Artwork label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About chapter · atlas",
      "blocks": [
        {
          "type": "plate",
          "settings": {
            "phrase": "the vastness of the sky",
            "label": "Longing for clouds",
            "alt": "Longing for clouds: a tall pour of white, grey-blue and gold"
          }
        },
        {
          "type": "plate",
          "settings": {
            "phrase": "the depth of the ocean",
            "label": "Jal – Water",
            "alt": "Jal – Water: cerulean and ultramarine cells pouring across white"
          }
        },
        {
          "type": "plate",
          "settings": {
            "phrase": "the stillness of mountains",
            "label": "Prithvi – Earth",
            "alt": "Prithvi – Earth: umber and ochre paint moving across white"
          }
        },
        {
          "type": "plate",
          "settings": {
            "phrase": "the freshness of spring",
            "label": "Colored by Nature – Purple",
            "alt": "Colored by Nature – Purple: violet and white fluid forms"
          }
        }
      ]
    }
  ]
}
{% endschema %}
