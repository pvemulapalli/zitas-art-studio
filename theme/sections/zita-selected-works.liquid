{%- assign products = section.settings.products -%}

{%- if products.count > 0 or request.design_mode -%}
  <div class="selected-works full-width">
    <div class="selected-works__inner page-width">
      <div class="section-head selected-works__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="section-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <p class="selected-works__intro">{{ section.settings.intro }}</p>
        {%- endif -%}
        <span class="selected-works__hint" aria-hidden="true">{{ 'selected_works.swipe' | t }}</span>
      </div>

      <ul class="selected-works__grid list-unstyled">
        {%- if products.count > 0 -%}
          {%- for product in products limit: 4 -%}
            <li class="selected-works__item">
              {%- render 'artwork-card',
                product: product,
                sizes: '(min-width: 1200px) 22vw, (min-width: 750px) 40vw, 78vw'
              -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- assign placeholder_text = 'editor.choose_products' | t -%}
          {%- for i in (1..4) -%}
            <li class="selected-works__item">
              {%- render 'artwork-plate', placeholder: placeholder_text -%}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .selected-works {
    background: var(--color-stone-mist);
  }

  .selected-works__inner {
    padding-block: clamp(88px, 10vw, 160px) var(--space-section-large);
  }

  .selected-works__head {
    gap: 24px;
  }

  .selected-works__intro {
    margin: 0;
    max-width: 28em;
    font-size: 18px;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  .selected-works__hint {
    display: none;
  }

  .selected-works__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    align-items: start;
    gap: clamp(20px, 3vw, 48px);
  }

  .selected-works__item {
    min-width: 0;
  }

  @media (max-width: 749px) {
    .selected-works__inner {
      padding: 48px 0 56px;
    }

    .selected-works__head {
      flex-wrap: nowrap;
      align-items: baseline;
      margin-block-end: 22px;
      padding-inline: var(--page-gutter);
    }

    .selected-works__intro {
      display: none;
    }

    .selected-works__hint {
      display: block;
      font-size: 14px;
      color: var(--color-text-meta);
    }

    .selected-works__grid {
      display: flex;
      gap: 14px;
      padding-inline: var(--page-gutter);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--page-gutter);
      scrollbar-width: none;
    }

    .selected-works__grid::-webkit-scrollbar {
      display: none;
    }

    .selected-works__item {
      flex: 0 0 78%;
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Selected works",
  "class": "section-selected-works",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Selected works"
    },
    {
      "type": "inline_richtext",
      "id": "intro",
      "label": "Intro",
      "info": "Hidden on phones."
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Artworks",
      "limit": 4,
      "info": "Title, price, size, sold state and images come from each product."
    }
  ],
  "presets": [
    {
      "name": "Selected works"
    }
  ]
}
{% endschema %}
