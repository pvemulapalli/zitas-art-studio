{%- liquid
  assign menu = section.settings.menu
  assign series_count = section.settings.series_count
  assign series_heading = section.settings.series_heading
-%}

<script src="{{ 'zita-header.js' | asset_url }}" defer></script>

<header class="site-header full-width">
  <div class="site-header__bar">
    <div class="site-header__inner page-width">
      <a class="site-header__wordmark" href="{{ routes.root_url }}" aria-label="{{ 'header.home_label' | t: shop: shop.name }}">
        {%- render 'wordmark' -%}
      </a>

      {%- if menu.links.size > 0 -%}
        <nav class="site-nav" aria-label="{{ 'header.main_navigation' | t }}">
          <ul class="site-nav__list list-unstyled">
            {%- for link in menu.links -%}
              <li class="site-nav__item">
                {%- if link.links.size > 0 -%}
                  <zita-mega-menu class="site-nav__dropdown">
                    <details>
                      <summary class="site-nav__link{% if link.child_active or link.current %} is-current{% endif %}">
                        {{- link.title | escape -}}
                        {%- render 'icon', name: 'chevron-down', size: 14, class: 'site-nav__chevron' -%}
                      </summary>
                      <div class="mega-menu">
                        <div class="mega-menu__inner page-width">
                          {%- if series_count > 0 -%}
                            <div class="mega-menu__series">
                              {%- if series_heading != blank -%}
                                <p class="eyebrow">{{ series_heading | escape }}</p>
                              {%- endif -%}
                              <ul class="list-unstyled">
                                {%- for child in link.links limit: series_count -%}
                                  <li>
                                    <a
                                      class="mega-menu__series-link"
                                      href="{{ child.url }}"
                                      data-preview-index="{{ forloop.index0 }}"
                                      {% if child.current %}
                                        aria-current="page"
                                      {% endif %}
                                    >
                                      <span class="mega-menu__series-name">{{ child.title | escape }}</span>
                                      {%- if child.type == 'collection_link' and child.object.products_count > 0 -%}
                                        <span class="mega-menu__series-meta">
                                          {{- 'header.originals_count' | t: count: child.object.products_count -}}
                                        </span>
                                      {%- endif -%}
                                    </a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            </div>
                          {%- endif -%}

                          {%- if link.links.size > series_count -%}
                            <ul class="mega-menu__links list-unstyled">
                              {%- for child in link.links offset: series_count -%}
                                <li>
                                  <a
                                    href="{{ child.url }}"
                                    {% if child.current %}
                                      aria-current="page"
                                    {% endif %}
                                  >
                                    {{- child.title | escape -}}
                                  </a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}

                          {%- if series_count > 0 -%}
                            <div class="mega-menu__preview" aria-hidden="true">
                              {%- for child in link.links limit: series_count -%}
                                {%- liquid
                                  assign preview_image = nil
                                  if child.type == 'collection_link' or child.type == 'product_link'
                                    assign preview_image = child.object.featured_image
                                  endif
                                -%}
                                <div class="mega-menu__preview-item" data-preview-index="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %}>
                                  {%- if preview_image -%}
                                    {%- render 'artwork-plate',
                                      image: preview_image,
                                      sizes: '(min-width: 1000px) 26vw, 1px',
                                      class: 'artwork-plate--square artwork-plate--wide-pad'
                                    -%}
                                  {%- endif -%}
                                </div>
                              {%- endfor -%}
                            </div>
                          {%- endif -%}
                        </div>
                      </div>
                    </details>
                  </zita-mega-menu>
                {%- else -%}
                  <a
                    class="site-nav__link{% if link.current or link.child_active %} is-current{% endif %}"
                    href="{{ link.url }}"
                    {% if link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{- link.title | escape -}}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      <div class="site-header__icons">
        <a class="icon-button site-header__search" href="{{ routes.search_url }}" aria-label="{{ 'header.search' | t }}">
          {%- render 'icon', name: 'search' -%}
        </a>

        {%- if settings.social_instagram_link != blank -%}
          <a
            class="icon-button site-header__instagram"
            href="{{ settings.social_instagram_link }}"
            aria-label="{{ 'general.instagram' | t }}"
            target="_blank"
            rel="noopener"
          >
            {%- render 'icon', name: 'instagram' -%}
          </a>
        {%- endif -%}

        <a class="icon-button site-header__bag" href="{{ routes.cart_url }}" aria-label="{{ 'header.bag' | t: count: cart.item_count }}">
          {%- render 'icon', name: 'shopping-bag' -%}
          {%- if cart.item_count > 0 -%}
            <span class="site-header__badge" aria-hidden="true">{{ cart.item_count }}</span>
          {%- endif -%}
        </a>

        <zita-mobile-menu class="mobile-menu">
          <details scroll-lock>
            <summary class="mobile-menu__toggle">
              <span class="mobile-menu__label-open">{{ 'header.menu' | t }}</span>
              <span class="mobile-menu__label-close">{{ 'header.close' | t }}</span>
            </summary>

            <div class="mobile-menu__panel">
              {%- if menu.links.size > 0 -%}
                <nav class="mobile-menu__nav" aria-label="{{ 'header.main_navigation' | t }}">
                  {%- for link in menu.links -%}
                    {%- if link.links.size > 0 -%}
                      <div class="mobile-menu__group">
                        <p class="eyebrow mobile-menu__eyebrow">
                          {{- link.title | escape -}}
                          {%- if series_count > 0 and series_heading != blank %} · {{ series_heading | escape }}{% endif -%}
                        </p>

                        {%- if series_count > 0 -%}
                          <ul class="list-unstyled">
                            {%- for child in link.links limit: series_count -%}
                              {%- liquid
                                assign thumb_image = nil
                                if child.type == 'collection_link' or child.type == 'product_link'
                                  assign thumb_image = child.object.featured_image
                                endif
                              -%}
                              <li>
                                <a
                                  class="mobile-menu__series"
                                  href="{{ child.url }}"
                                  {% if child.current %}
                                    aria-current="page"
                                  {% endif %}
                                >
                                  <span class="mobile-menu__thumb">
                                    {%- if thumb_image -%}
                                      {%- render 'responsive-image',
                                        image: thumb_image,
                                        sizes: '48px',
                                        widths: '96, 144',
                                        decorative: true
                                      -%}
                                    {%- endif -%}
                                  </span>
                                  <span class="mobile-menu__series-text">
                                    <span class="mobile-menu__series-name">{{ child.title | escape }}</span>
                                    {%- if child.type == 'collection_link' and child.object.products_count > 0 -%}
                                      <span class="mobile-menu__series-meta">
                                        {{- 'header.originals_count' | t: count: child.object.products_count -}}
                                      </span>
                                    {%- endif -%}
                                  </span>
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}

                        {%- if link.links.size > series_count -%}
                          <ul class="list-unstyled mobile-menu__more">
                            {%- for child in link.links offset: series_count -%}
                              <li>
                                <a
                                  class="mobile-menu__more-link"
                                  href="{{ child.url }}"
                                  {% if child.current %}
                                    aria-current="page"
                                  {% endif %}
                                >
                                  {{- child.title | escape -}}
                                  {%- render 'icon', name: 'arrow-right', size: 16 -%}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  {%- endfor -%}

                  <ul class="list-unstyled mobile-menu__rows">
                    {%- for link in menu.links -%}
                      {%- if link.links.size == 0 -%}
                        <li>
                          <a
                            class="mobile-menu__row"
                            href="{{ link.url }}"
                            {% if link.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{- link.title | escape -}}
                          </a>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </nav>
              {%- endif -%}

              {%- if settings.social_instagram_link != blank or settings.contact_email != blank -%}
                <div class="mobile-menu__contact">
                  {%- if settings.social_instagram_link != blank -%}
                    <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">
                      {%- render 'icon', name: 'instagram', size: 18 -%}
                      {{- 'header.follow_instagram' | t -}}
                    </a>
                  {%- endif -%}
                  {%- if settings.contact_email != blank -%}
                    <a href="mailto:{{ settings.contact_email | strip }}">{{ settings.contact_email | escape }}</a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </details>
        </zita-mobile-menu>
      </div>
    </div>
  </div>
</header>

{% stylesheet %}
  .site-header {
    position: relative;
    z-index: 20;
  }

  .site-header__bar {
    background: var(--color-gesso);
    border-bottom: var(--hairline);
  }

  .site-header__inner {
    display: flex;
    align-items: stretch;
    min-height: var(--header-height);
  }

  .site-header__wordmark {
    display: flex;
    align-items: center;
    flex: none;
    margin-inline-end: 56px;
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
  }

  .site-nav__list {
    display: flex;
    align-items: stretch;
    gap: 34px;
  }

  .site-nav__item {
    display: flex;
  }

  .site-nav__dropdown,
  .site-nav__dropdown > details {
    display: flex;
  }

  .site-nav__link {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-size: 13px;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-ink);
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }

  .site-nav__link::-webkit-details-marker {
    display: none;
  }

  .site-nav__link:hover,
  details[open] > .site-nav__link {
    color: var(--color-copper);
  }

  .site-nav__link.is-current {
    color: var(--color-teal);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 8px;
  }

  .site-nav__chevron {
    transition: transform var(--duration-fast) var(--ease-pour);
  }

  details[open] > .site-nav__link .site-nav__chevron {
    transform: rotate(180deg);
  }

  .mega-menu {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    background: var(--color-gesso);
    border-top: var(--hairline);
    box-shadow: var(--shadow-overlay);
  }

  .mega-menu__inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr 0.9fr;
    gap: clamp(24px, 4vw, 64px);
    padding-block: 40px 48px;
  }

  .mega-menu__series {
    display: grid;
    align-content: start;
    gap: 8px;
  }

  .mega-menu__series-link {
    display: grid;
    gap: 2px;
    padding-block: 12px;
    border-bottom: var(--hairline);
    color: var(--color-ink);
    text-decoration: none;
  }

  .mega-menu__series-name {
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.2;
    transition: color var(--duration-fast) var(--ease-pour);
  }

  .mega-menu__series-link:hover .mega-menu__series-name,
  .mega-menu__series-link:focus-visible .mega-menu__series-name {
    color: var(--color-copper);
  }

  .mega-menu__series-meta {
    font-size: 15px;
    line-height: 1.45;
    color: var(--color-text-meta);
  }

  .mega-menu__links {
    display: grid;
    align-content: start;
    gap: 14px;
    padding-block-start: 30px;
  }

  .mega-menu__links a {
    font-size: 19px;
    line-height: 1.4;
    color: var(--color-ink);
    text-decoration: none;
  }

  .mega-menu__links a:hover {
    color: var(--color-copper);
  }

  .mega-menu__preview {
    grid-column: 3;
  }

  .site-header__icons {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-inline-start: auto;
    padding-inline-start: 16px;
  }

  .site-header__badge {
    position: absolute;
    top: 4px;
    right: 2px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 8px;
    background: var(--color-copper);
    color: var(--color-gesso);
    font-family: var(--font-display);
    font-size: 10px;
    line-height: 16px;
    text-align: center;
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 1279px) {
    .site-nav__list {
      gap: 22px;
    }
  }

  @media (max-width: 1179px) {
    .site-header__wordmark {
      margin-inline-end: 28px;
    }

    .site-header__instagram {
      display: none;
    }
  }

  @media (max-width: 999px) {
    .site-header {
      min-height: var(--header-height);
    }

    .site-header__inner {
      padding-inline: 20px 8px;
    }

    .site-nav,
    .site-header__search {
      display: none;
    }

    .mobile-menu {
      display: block;
    }

    .site-header:has(.mobile-menu > details[open]) .site-header__bar {
      position: fixed;
      inset-block-start: 0;
      inset-inline: 0;
      z-index: 2;
    }

    .mobile-menu__toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 64px;
      min-height: 44px;
      padding: 0 8px;
      font-family: var(--font-display);
      font-size: 12px;
      line-height: 1;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--color-ink);
      cursor: pointer;
      list-style: none;
    }

    .mobile-menu__toggle::-webkit-details-marker {
      display: none;
    }

    .mobile-menu__label-close,
    details[open] > .mobile-menu__toggle .mobile-menu__label-open {
      display: none;
    }

    details[open] > .mobile-menu__toggle .mobile-menu__label-close {
      display: inline;
    }

    .mobile-menu__panel {
      position: fixed;
      inset: var(--header-height) 0 0;
      z-index: 1;
      display: grid;
      align-content: start;
      gap: 28px;
      padding: 24px 20px 36px;
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--color-gesso);
      animation: mobile-menu-in 240ms var(--ease-pour);
    }

    .mobile-menu__nav {
      display: grid;
      gap: 28px;
    }

    .mobile-menu__group {
      display: grid;
    }

    .mobile-menu__eyebrow {
      margin-block-end: 8px;
    }

    .mobile-menu__series {
      display: flex;
      align-items: center;
      gap: 16px;
      min-height: 64px;
      padding-block: 10px;
      border-bottom: var(--hairline);
      color: var(--color-ink);
      text-decoration: none;
    }

    .mobile-menu__thumb {
      display: flex;
      align-items: center;
      justify-content: center;
      flex: none;
      width: 64px;
      height: 64px;
      padding: 8px;
      background: var(--color-mat);
    }

    .mobile-menu__thumb img {
      width: auto;
      height: auto;
      max-width: 100%;
      max-height: 100%;
    }

    .mobile-menu__series-text {
      display: grid;
      gap: 2px;
    }

    .mobile-menu__series-name {
      font-family: var(--font-display);
      font-size: 22px;
      line-height: 1.2;
    }

    .mobile-menu__series-meta {
      font-size: 15px;
      line-height: 1.4;
      color: var(--color-text-meta);
    }

    .mobile-menu__more {
      padding-block-start: 8px;
    }

    .mobile-menu__more-link {
      display: flex;
      align-items: center;
      gap: 10px;
      min-height: 52px;
      font-family: var(--font-display);
      font-size: 13px;
      line-height: 1.3;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--color-teal);
      text-decoration: none;
    }

    .mobile-menu__row {
      display: flex;
      align-items: center;
      min-height: 52px;
      border-top: var(--hairline);
      font-family: var(--font-display);
      font-size: 19px;
      line-height: 1.2;
      color: var(--color-ink);
      text-decoration: none;
    }

    .mobile-menu__row[aria-current='page'],
    .mobile-menu__series[aria-current='page'] .mobile-menu__series-name {
      color: var(--color-teal);
    }

    .mobile-menu__contact {
      display: grid;
      justify-items: start;
      gap: 4px;
      font-size: 16px;
    }

    .mobile-menu__contact a {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      min-height: 44px;
      color: var(--color-ink);
    }
  }

  @keyframes mobile-menu-in {
    from {
      opacity: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Navigation comes from this Shopify menu. Give an item child links (for example Originals) to turn it into a dropdown."
    },
    {
      "type": "header",
      "content": "Series in dropdowns"
    },
    {
      "type": "range",
      "id": "series_count",
      "label": "Series per dropdown",
      "min": 0,
      "max": 6,
      "step": 1,
      "default": 3,
      "info": "The first child links of a dropdown show as series, with the collection image as a preview. Remaining child links show as plain links."
    },
    {
      "type": "text",
      "id": "series_heading",
      "label": "Series heading",
      "default": "Current series"
    }
  ]
}
{% endschema %}
