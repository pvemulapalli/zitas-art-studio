{%- liquid
  assign link_collection = section.settings.link_collection
  if link_collection != blank
    assign link_url = link_collection.url
  else
    assign link_url = routes.all_products_collection_url
  endif
  assign heading_id = 'RelatedWorks-' | append: section.id
-%}

<script src="{{ 'zita-product.js' | asset_url }}" defer></script>

{%- if product -%}
  {%- capture recommendations_url -%}
    {{- routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=3&intent=related
  {%- endcapture -%}
{%- endif -%}

<product-recommendations class="related-works full-width" data-url="{{ recommendations_url | escape }}">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <section class="related-works__inner page-width page-width--wide" aria-labelledby="{{ heading_id }}">
      <div class="section-head related-works__head">
        <h2 class="section-heading related-works__heading" id="{{ heading_id }}">{{ section.settings.heading | escape }}</h2>
        {%- render 'label-link', url: link_url, label: section.settings.link_label -%}
      </div>
      <ul class="related-works__grid list-unstyled" role="list">
        {%- for related_product in recommendations.products -%}
          <li class="related-works__item">
            {%- render 'artwork-card',
              product: related_product,
              sizes: '(min-width: 1800px) 540px, (min-width: 1100px) 31vw, (min-width: 750px) 46vw, 78vw'
            -%}
          </li>
        {%- endfor -%}
      </ul>
    </section>
  {%- endif -%}
</product-recommendations>

{% stylesheet %}
  .related-works {
    display: block;
    background: var(--color-stone-mist);
  }

  .related-works__inner {
    padding-block: var(--space-section);
  }

  .related-works__head {
    margin-block-end: clamp(36px, 4vw, 56px);
  }

  .related-works__heading {
    font-size: clamp(28px, 2.6vw, 40px);
  }

  .related-works__grid {
    --related-gap: clamp(24px, 3vw, 56px);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(max(260px, calc((100% - 2 * var(--related-gap)) / 3)), 1fr));
    align-items: start;
    gap: var(--related-gap);
  }

  .related-works__item {
    min-width: 0;
  }

  @media (min-width: 750px) {
    .related-works__grid .artwork-plate {
      aspect-ratio: 8 / 9;
    }
  }

  @media (max-width: 749px) {
    .related-works__inner {
      padding: 48px 0;
    }

    .related-works__head {
      margin-block-end: 24px;
      padding-inline: var(--page-gutter);
    }

    .related-works__heading {
      font-size: 24px;
    }

    .related-works__grid {
      display: flex;
      gap: 14px;
      padding-inline: var(--page-gutter);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--page-gutter);
      scrollbar-width: none;
    }

    .related-works__grid::-webkit-scrollbar {
      display: none;
    }

    .related-works__item {
      flex: 0 0 78%;
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Related works",
  "class": "section-related-works",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Up to three works chosen by Shopify product recommendations. Hidden when there are none."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More originals"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "All originals"
    },
    {
      "type": "collection",
      "id": "link_collection",
      "label": "Link collection",
      "info": "Without one, the link goes to all products."
    }
  ]
}
{% endschema %}
