{%- assign series_menu = section.settings.series_menu -%}

<div class="collection-intro full-width">
  <div class="collection-intro__inner page-width page-width--wide">
    <div class="collection-intro__head">
      <div class="collection-intro__titles">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h1 class="collection-intro__title">{{ collection.title | escape }}</h1>
      </div>

      {%- if collection.description != blank -%}
        <div class="collection-intro__description">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- if series_menu.links.size > 0 -%}
      <nav class="collection-series" aria-label="{{ 'plp.series_nav' | t }}">
        <ul class="collection-series__list list-unstyled">
          {%- for link in series_menu.links -%}
            {%- liquid
              assign is_current = link.current
              if link.type == 'collection_link' and link.object.id == collection.id
                assign is_current = true
              elsif link.type == 'catalog_link' and collection.handle == 'all'
                assign is_current = true
              endif
            -%}
            <li>
              <a
                class="collection-series__link"
                href="{{ link.url }}"
                {% if is_current %}
                  aria-current="page"
                {% endif %}
              >
                {{- link.title | escape -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .collection-intro__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px 48px;
    padding-block: clamp(56px, 6vw, 96px) clamp(28px, 3vw, 40px);
  }

  .collection-intro__titles {
    display: grid;
    gap: 14px;
  }

  .collection-intro__title {
    margin: 0;
    font-size: clamp(40px, 4.4vw, 64px);
    line-height: 1.05;
  }

  .collection-intro__description {
    max-width: 30em;
    font-size: 18px;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  .collection-intro__description > * {
    margin: 0;
  }

  .collection-intro__description > * + * {
    margin-block-start: 0.8em;
  }

  .collection-series__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 30px;
    border-bottom: 1px solid var(--color-stone-200);
  }

  .collection-series__link {
    display: block;
    margin-block-end: -1px;
    padding-block: 14px;
    border-bottom: 1px solid transparent;
    font-family: var(--font-display);
    font-size: 13px;
    line-height: 1.2;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text-secondary);
  }

  .collection-series__link:hover {
    color: var(--color-copper);
  }

  .collection-series__link[aria-current='page'] {
    border-bottom-color: var(--color-teal);
    color: var(--color-teal);
  }

  @media (max-width: 749px) {
    .collection-intro__inner {
      padding-inline: 0;
    }

    .collection-intro__head {
      gap: 8px;
      padding: 28px 20px 8px;
    }

    .collection-intro__titles {
      gap: 8px;
    }

    .collection-intro__title {
      font-size: 36px;
      line-height: 1.1;
    }

    .collection-intro__description {
      display: none;
    }

    .collection-series__list {
      flex-wrap: nowrap;
      gap: 8px;
      padding: 14px 20px 18px;
      overflow-x: auto;
      border: 0;
      scrollbar-width: none;
    }

    .collection-series__list::-webkit-scrollbar {
      display: none;
    }

    .collection-series__link {
      display: flex;
      align-items: center;
      min-height: 44px;
      margin: 0;
      padding: 0 14px;
      border: 1px solid var(--color-stone-200);
      border-radius: 2px;
      font-family: var(--font-body);
      font-size: 15px;
      letter-spacing: 0;
      text-transform: none;
      white-space: nowrap;
      color: var(--color-ink);
    }

    .collection-series__link[aria-current='page'] {
      border-color: var(--color-ink);
      background: var(--color-ink);
      color: var(--color-gesso);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection intro",
  "class": "section-collection-intro",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Zita’s Art Studio",
      "info": "Shown above the collection title on every collection that uses this template. Leave blank to hide."
    },
    {
      "type": "link_list",
      "id": "series_menu",
      "label": "Series menu",
      "info": "A menu of collection links shown as tabs under the title. The current collection is highlighted. Title and description come from the collection."
    }
  ],
  "presets": [
    {
      "name": "Collection intro"
    }
  ]
}
{% endschema %}
