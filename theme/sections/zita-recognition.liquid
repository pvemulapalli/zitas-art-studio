<div class="recognition full-width">
  <div class="recognition__inner page-width">
    {%- if section.settings.image -%}
      <div class="recognition__media">
        {%- render 'responsive-image',
          image: section.settings.image,
          sizes: '(min-width: 750px) min(460px, 40vw), 72vw',
          widths: '360, 480, 640, 920, 1200',
          class: 'recognition__image'
        -%}
      </div>
    {%- elsif request.design_mode -%}
      <div class="recognition__media">
        <span class="editor-placeholder recognition__placeholder">{{ 'editor.add_image' | t }}</span>
      </div>
    {%- endif -%}

    <div class="recognition__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="recognition__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="recognition__body">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.secondary != blank -%}
        <p class="recognition__secondary">{{ section.settings.secondary | escape }}</p>
      {%- endif -%}
      {%- if section.settings.link_url != blank and section.settings.link_label != blank -%}
        <div>
          {%- render 'label-link',
            url: section.settings.link_url,
            label: section.settings.link_label,
            tone: 'dark'
          -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .recognition {
    --eyebrow-color: var(--color-gold);
    background: var(--color-night);
    color: var(--color-gesso);
  }

  .recognition__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(40px, 7vw, 128px);
    padding-block: clamp(80px, 10vw, 160px);
  }

  .recognition__media {
    display: flex;
    justify-content: center;
    flex: 5 1 320px;
    color: var(--color-stone-300);
  }

  .recognition__image {
    width: min(100%, 460px);
    height: auto;
  }

  .recognition__placeholder {
    max-width: 460px;
    aspect-ratio: 4 / 5;
  }

  .recognition__text {
    display: grid;
    gap: 26px;
    flex: 6 1 380px;
    max-width: 620px;
  }

  .recognition__heading {
    margin: 0;
    font-size: clamp(40px, 4.4vw, 68px);
    line-height: 1.05;
    color: var(--color-gesso);
  }

  .recognition__body {
    font-size: 20px;
    line-height: 1.6;
    color: var(--color-stone-mist);
  }

  .recognition__body p {
    margin: 0;
  }

  .recognition__body p + p {
    margin-block-start: 1em;
  }

  .recognition__body a {
    color: inherit;
  }

  .recognition__secondary {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-stone-300);
  }

  @media (max-width: 749px) {
    .recognition__inner {
      gap: 18px;
      padding-block: 56px;
    }

    .recognition__media {
      flex-basis: 100%;
      margin-block-end: 12px;
    }

    .recognition__image {
      width: 72%;
    }

    .recognition__text {
      gap: 18px;
      flex-basis: 100%;
    }

    .recognition__heading {
      font-size: 34px;
      line-height: 1.1;
    }

    .recognition__body {
      font-size: 17px;
      line-height: 1.55;
    }

    .recognition__secondary {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Recognition",
  "class": "section-recognition",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Shown whole, without a shadow, on the dark ground."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Recognition"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text",
      "info": "Set the work's title in italics."
    },
    {
      "type": "text",
      "id": "secondary",
      "label": "Secondary line",
      "info": "Hidden on phones."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Exhibitions"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Recognition"
    }
  ]
}
{% endschema %}
