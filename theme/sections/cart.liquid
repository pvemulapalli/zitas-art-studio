{%- comment -%}
  V2 full cart page (Phase D C1).
  Progressive enhancement: with JS, "Update bag" uses /cart/change.js per line key and
  reloads on success; inventory errors are announced and quantities restored.
  Without JS, the form POSTs natively to /cart. Browser min/max help, but native form
  updates are not a guaranteed inventory ceiling — Shopify may accept oversell until checkout.
{%- endcomment -%}

{%- liquid
  assign continue_url = section.settings.continue_url
  if continue_url == blank
    assign continue_url = routes.all_products_collection_url
  endif

  assign continue_label = section.settings.continue_label
  if continue_label == blank
    assign continue_label = 'cart.continue_shopping' | t
  endif
-%}

<script src="{{ 'zita-cart.js' | asset_url }}" defer></script>

<section class="cart-page full-width">
  <div class="cart-page__inner page-width">
    <header class="cart-page__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="cart-page__title">{{ 'cart.title' | t }}</h1>
    </header>

    {%- if cart.item_count == 0 -%}
      <div class="cart-page__empty">
        <p class="cart-page__empty-text">{{ 'cart.empty' | t }}</p>
        {%- render 'label-link',
          url: continue_url,
          label: continue_label
        -%}
      </div>
    {%- else -%}
      <cart-page
        class="cart-page__enhance"
        data-cart-change-url="{{ routes.cart_change_url }}.js"
        data-error-generic="{{ 'cart.error_generic' | t | escape }}"
        data-no-changes-message="{{ 'cart.no_changes' | t | escape }}"
      >
        <div
          class="cart-page__status"
          id="CartPageStatus"
          role="alert"
          aria-live="assertive"
          tabindex="-1"
          data-cart-status
          hidden
        ></div>

        <form
          class="cart-page__form"
          action="{{ routes.cart_url }}"
          method="post"
          id="CartPageForm"
          data-cart-form
        >
          <div class="cart-page__layout">
            <ul class="cart-lines list-unstyled" role="list">
              {%- for item in cart.items -%}
                {%- liquid
                  assign line_id = 'CartLineQty-' | append: item.index
                  assign line_error_id = 'CartLineError-' | append: item.index
                  assign line_note_id = 'CartLineNote-' | append: item.index
                  assign min_qty = 0
                  if item.variant.quantity_rule.min != blank
                    assign min_qty = item.variant.quantity_rule.min
                  endif

                  assign max_qty = blank
                  assign inventory_limited = false
                  if item.variant.quantity_rule.max != blank
                    assign max_qty = item.variant.quantity_rule.max
                  endif

                  if item.variant.inventory_management != blank and item.variant.inventory_policy == 'deny'
                    assign stock_max = item.variant.inventory_quantity
                    if stock_max < 0
                      assign stock_max = 0
                    endif
                    if max_qty == blank or stock_max < max_qty
                      assign max_qty = stock_max
                    endif
                    assign inventory_limited = true
                  endif

                  assign show_one_original_note = false
                  if item.product.template_suffix == 'original' and inventory_limited and max_qty == 1
                    assign show_one_original_note = true
                  endif

                  assign describedby = line_error_id
                  if show_one_original_note
                    assign describedby = line_note_id | append: ' ' | append: line_error_id
                  endif
                -%}
                <li class="cart-line">
                  <a class="cart-line__media" href="{{ item.url }}">
                    {%- if item.image -%}
                      {%- render 'responsive-image',
                        image: item.image,
                        sizes: '96px',
                        widths: '96, 192, 288',
                        class: 'cart-line__image',
                        alt: item.product.title,
                        loading: 'lazy'
                      -%}
                    {%- else -%}
                      <span class="cart-line__media-placeholder" aria-hidden="true"></span>
                    {%- endif -%}
                  </a>

                  <div class="cart-line__details">
                    <div class="cart-line__copy">
                      <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                      {%- unless item.product.has_only_default_variant -%}
                        <p class="cart-line__variant">{{ item.variant.title | escape }}</p>
                      {%- endunless -%}
                      <p class="cart-line__unit">
                        <span class="visually-hidden">{{ 'cart.unit_price' | t }}: </span>
                        {{ item.final_price | money_without_trailing_zeros }}
                      </p>
                    </div>

                    <div class="cart-line__controls">
                      <div class="cart-line__qty">
                        <label class="cart-line__qty-label" for="{{ line_id }}">{{ 'cart.quantity' | t }}</label>
                        <input
                          class="cart-line__qty-input"
                          type="number"
                          id="{{ line_id }}"
                          name="updates[{{ item.key }}]"
                          value="{{ item.quantity }}"
                          min="{{ min_qty }}"
                          {% if max_qty != blank %}
                            max="{{ max_qty }}"
                          {% endif %}
                          inputmode="numeric"
                          autocomplete="off"
                          data-cart-qty
                          data-line-key="{{ item.key | escape }}"
                          data-accepted-quantity="{{ item.quantity }}"
                          data-line-error="{{ line_error_id }}"
                          {% if inventory_limited and max_qty != blank %}
                            data-available-message="{{ 'cart.quantity_available' | t: count: max_qty | escape }}"
                          {% endif %}
                          aria-describedby="{{ describedby }}"
                          aria-invalid="false"
                        >
                        {%- if show_one_original_note -%}
                          <p class="cart-line__note" id="{{ line_note_id }}">
                            {{- 'cart.one_original_available' | t -}}
                          </p>
                        {%- endif -%}
                        <p
                          class="cart-line__error"
                          id="{{ line_error_id }}"
                          data-cart-line-error
                          role="alert"
                          hidden
                        ></p>
                      </div>

                      <a class="cart-line__remove" href="{{ item.url_to_remove }}">
                        {{- 'cart.remove' | t -}}
                      </a>
                    </div>
                  </div>

                  <p class="cart-line__total">
                    <span class="visually-hidden">{{ 'cart.line_total' | t }}: </span>
                    {{ item.final_line_price | money_without_trailing_zeros }}
                  </p>
                </li>
              {%- endfor -%}
            </ul>

            <aside class="cart-summary" aria-labelledby="CartSummaryHeading">
              <h2 class="cart-summary__heading visually-hidden" id="CartSummaryHeading">
                {{- 'cart.summary' | t -}}
              </h2>

              <div class="cart-summary__row">
                <span class="cart-summary__label">{{ 'cart.subtotal' | t }}</span>
                <span class="cart-summary__value">{{ cart.total_price | money_without_trailing_zeros }}</span>
              </div>

              <p class="cart-summary__note">{{ 'cart.taxes_and_shipping' | t }}</p>

              <div class="cart-summary__actions">
                <button type="submit" name="update" class="button button--secondary cart-summary__update">
                  {{- 'cart.update' | t -}}
                </button>
                <button type="submit" name="checkout" class="button button--large cart-summary__checkout">
                  {{- 'cart.checkout' | t -}}
                </button>
              </div>

              {%- render 'label-link',
                url: continue_url,
                label: continue_label,
                class: 'cart-summary__continue'
              -%}
            </aside>
          </div>
        </form>
      </cart-page>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .cart-page {
    background: var(--color-gesso);
  }

  .cart-page__inner {
    padding-block: var(--space-section) clamp(64px, 8vw, 120px);
  }

  .cart-page__header {
    display: grid;
    gap: 12px;
    margin-block-end: var(--space-heading-to-content);
  }

  .cart-page__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(32px, 3.2vw, 48px);
    font-weight: 400;
    line-height: 1.15;
    color: var(--color-ink);
  }

  .cart-page__status {
    margin-block-end: 24px;
    padding: 14px 16px;
    border: 1px solid var(--color-sold);
    background: #f8efe9;
    color: var(--color-ink);
    font-size: 16px;
    line-height: 1.5;
  }

  .cart-page__status:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .cart-page__empty {
    display: grid;
    gap: 28px;
    justify-items: start;
    max-width: 28em;
  }

  .cart-page__empty-text {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .cart-page__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 320px);
    gap: clamp(40px, 6vw, 80px);
    align-items: start;
  }

  .cart-lines {
    display: grid;
    gap: 0;
    border-top: var(--hairline);
  }

  .cart-line {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) auto;
    gap: 20px 24px;
    align-items: start;
    padding-block: 28px;
    border-bottom: var(--hairline);
  }

  .cart-line__media {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    padding: 10px;
    background: var(--color-mat);
    text-decoration: none;
  }

  .cart-line__image {
    width: auto;
    max-width: 100%;
    max-height: 100%;
    height: auto;
    object-fit: contain;
  }

  .cart-line__media-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--color-stone-mist);
  }

  .cart-line__details {
    display: grid;
    gap: 16px;
    min-width: 0;
  }

  .cart-line__copy {
    display: grid;
    gap: 6px;
  }

  .cart-line__title {
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 1.25;
    color: var(--color-ink);
    text-decoration: none;
  }

  .cart-line__title:hover {
    color: var(--color-teal);
  }

  .cart-line__variant,
  .cart-line__unit {
    margin: 0;
    font-size: 15px;
    line-height: 1.45;
    color: var(--color-text-meta);
  }

  .cart-line__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 16px 24px;
  }

  .cart-line__qty {
    display: grid;
    gap: 8px;
    max-width: 16rem;
  }

  .cart-line__qty-label {
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-meta);
  }

  .cart-line__qty-input {
    width: 4.5rem;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--color-stone-200);
    border-radius: 0;
    background: var(--color-gesso);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.2;
  }

  .cart-line__qty-input:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .cart-line__qty-input[aria-invalid='true'] {
    border-color: var(--color-sold);
  }

  .cart-line__note {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
    color: var(--color-text-meta);
  }

  .cart-line__error {
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-sold);
  }

  .cart-line__remove {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 15px;
    color: var(--color-text-meta);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .cart-line__remove:hover {
    color: var(--color-copper);
  }

  .cart-line__total {
    margin: 0;
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 1.3;
    color: var(--color-ink);
    text-align: end;
    white-space: nowrap;
  }

  .cart-summary {
    display: grid;
    gap: 16px;
    padding: 28px 24px;
    border: var(--hairline);
    background: var(--color-mat);
  }

  .cart-summary__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }

  .cart-summary__label {
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-meta);
  }

  .cart-summary__value {
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.2;
    color: var(--color-ink);
  }

  .cart-summary__note {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-text-meta);
  }

  .cart-summary__actions {
    display: grid;
    gap: 12px;
    margin-block-start: 8px;
  }

  .cart-summary__update,
  .cart-summary__checkout {
    width: 100%;
  }

  .cart-summary__update:disabled,
  .cart-summary__checkout:disabled {
    opacity: 0.55;
    cursor: wait;
  }

  .cart-summary__continue {
    justify-self: start;
    margin-block-start: 8px;
  }

  @media (max-width: 899px) {
    .cart-page__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    .cart-summary {
      position: static;
    }
  }

  @media (max-width: 749px) {
    .cart-page__inner {
      padding-block: 48px 72px;
    }

    .cart-page__header {
      margin-block-end: 28px;
    }

    .cart-page__title {
      font-size: 28px;
    }

    .cart-page__empty-text {
      font-size: 16px;
    }

    .cart-line {
      grid-template-columns: 80px minmax(0, 1fr);
      gap: 16px;
      padding-block: 22px;
    }

    .cart-line__media {
      width: 80px;
      height: 80px;
      padding: 8px;
    }

    .cart-line__title {
      font-size: 18px;
    }

    .cart-line__total {
      grid-column: 2;
      text-align: start;
      font-size: 17px;
    }

    .cart-summary {
      padding: 24px 20px;
    }

    .cart-summary__value {
      font-size: 22px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Bag"
    },
    {
      "type": "text",
      "id": "continue_label",
      "label": "Continue shopping label",
      "default": "View originals"
    },
    {
      "type": "url",
      "id": "continue_url",
      "label": "Continue shopping link",
      "info": "Defaults to All products when blank. Prefer the Originals collection when it exists."
    }
  ]
}
{% endschema %}
