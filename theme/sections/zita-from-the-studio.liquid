{%- assign instagram_url = section.settings.instagram_url | default: settings.social_instagram_link -%}

<div class="studio full-width">
  <div class="studio__inner page-width">
    <div class="studio__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="studio__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if instagram_url != blank and section.settings.button_label != blank -%}
        <a
          class="button button--secondary studio__button"
          href="{{ instagram_url }}"
          target="_blank"
          rel="noopener"
        >
          {%- render 'icon', name: 'instagram', size: 18 -%}
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.image_1 or section.settings.image_2 or section.settings.image_3 or request.design_mode -%}
      <div class="studio__images">
        {%- for i in (1..3) -%}
          {%- liquid
            case i
              when 1
                assign post_image = section.settings.image_1
              when 2
                assign post_image = section.settings.image_2
              else
                assign post_image = section.settings.image_3
            endcase
          -%}
          <div class="studio__post">
            {%- if post_image -%}
              {%- render 'responsive-image',
                image: post_image,
                sizes: '(min-width: 1200px) 18vw, (min-width: 750px) 28vw, 30vw',
                widths: '240, 360, 480, 640, 800',
                class: 'studio__image'
              -%}
            {%- elsif request.design_mode -%}
              <span class="editor-placeholder">{{ 'editor.add_image' | t }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .studio {
    --eyebrow-color: var(--color-teal);
    background: var(--color-vaayu-mist);
  }

  .studio__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
    padding-block: var(--space-section);
  }

  .studio__text {
    display: grid;
    justify-items: start;
    gap: 20px;
    flex: 4 1 300px;
    max-width: 460px;
  }

  .studio__heading {
    margin: 0;
    font-size: clamp(30px, 2.8vw, 42px);
    line-height: 1.15;
  }

  .studio__images {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: clamp(12px, 1.6vw, 24px);
    flex: 7 1 420px;
  }

  .studio__post {
    position: relative;
    aspect-ratio: 4 / 5;
    color: var(--color-text-meta);
  }

  .studio__post:nth-child(2) {
    margin-block-start: clamp(24px, 4vw, 64px);
  }

  .studio__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focal, 50% 50%);
  }

  @media (max-width: 749px) {
    .studio__inner {
      gap: 16px;
      padding-block: 48px;
    }

    .studio__text {
      display: contents;
    }

    .studio__text > .eyebrow,
    .studio__heading {
      flex-basis: 100%;
    }

    .studio__heading {
      font-size: 24px;
      line-height: 1.2;
    }

    .studio__images {
      order: 1;
      flex-basis: 100%;
      gap: 8px;
    }

    .studio__post:nth-child(2) {
      margin-block-start: 0;
    }

    .studio__button {
      order: 2;
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "From the studio",
  "class": "section-from-the-studio",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "From the studio"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New work and studio moments, shared on Instagram."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Follow Ranjeeta"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram link",
      "info": "Leave blank to use the Instagram profile in Theme settings > Contact and social."
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "paragraph",
      "content": "Three recent posts or studio photographs, cropped to 4:5."
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    }
  ],
  "presets": [
    {
      "name": "From the studio"
    }
  ]
}
{% endschema %}
