        },
        { "type": "textarea", "id": "two_linked_works", "label": "Linked works" },
        { "type": "text", "id": "two_suffix", "label": "Suffix" },
        { "type": "header", "content": "Entry 3" },
        { "type": "text", "id": "three_num", "label": "Number", "default": "07" },
        { "type": "text", "id": "three_year", "label": "Year (omit label if blank)" },
        { "type": "text", "id": "three_title", "label": "Title", "default": "Global Cultures" },
        { "type": "text", "id": "three_place", "label": "Place", "default": "Plano Art Center" },
