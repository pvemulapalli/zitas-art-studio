      ]
    },
    {
      "type": "small_image",
      "name": "Small image entry",
      "settings": [
        { "type": "text", "id": "entry_num", "label": "Number", "default": "08" },
        { "type": "text", "id": "entry_year", "label": "Year (optional)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Sacred Stories of Light" },
        {
          "type": "textarea",
          "id": "place",
