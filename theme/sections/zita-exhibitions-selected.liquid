<div class="exhibitions-page">
  <section class="ex-selected" aria-labelledby="exhibitions-selected-heading">
    <div class="ex-shell">
      <div class="ex-selected__header">
        <h2 id="exhibitions-selected-heading" class="ex-selected__title">
          {{- section.settings.heading | default: 'Selected exhibitions' | escape -}}
        </h2>
        <a class="ex-archive-jump" href="#exhibitions-archive">{{ section.settings.archive_link_label | escape }}</a>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'large_image' -%}
            <article
              class="ex-grid-12 ex-selected__large ex-selected__entry{% if block.settings.image == blank %} ex-selected__large--no-image{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.image != blank -%}
                <div class="ex-selected__large-image ex-art-slot">
                  {%- render 'responsive-image',
                    image: block.settings.image,
                    alt: block.settings.image_alt,
                    sizes: '(min-width: 750px) 38vw, 72vw',
                    widths: '360, 540, 720',
                    loading: 'lazy',
                    class: ''
                  -%}
                </div>
              {%- endif -%}
              <div class="ex-selected__large-text ex-selected__body">
                {%- render 'exhibitions-selected-entry-meta', block: block, title_class: 'ex-selected__entry-title--lg' -%}
              </div>
            </article>

          {%- when 'typographic_pair' -%}
            <div class="ex-grid-12 ex-selected__pair" {{ block.shopify_attributes }}>
              <article class="ex-selected__pair-item ex-selected__entry">
                {%- render 'exhibitions-selected-pair-half',
                  num: block.settings.left_num,
                  year: block.settings.left_year,
                  title: block.settings.left_title,
                  place: block.settings.left_place
                -%}
              </article>
              <article class="ex-selected__pair-item ex-selected__entry">
                {%- render 'exhibitions-selected-pair-half',
                  num: block.settings.right_num,
                  year: block.settings.right_year,
                  title: block.settings.right_title,
                  place: block.settings.right_place
                -%}
              </article>
            </div>

          {%- when 'medium_image' -%}
            <article
              class="ex-grid-12 ex-selected__medium ex-selected__entry{% if block.settings.image == blank %} ex-selected__medium--no-image{% endif %}"
              {{ block.shopify_attributes }}
            >
              <div class="ex-selected__medium-text ex-selected__body">
                {%- render 'exhibitions-selected-entry-meta', block: block, title_class: 'ex-selected__entry-title--md' -%}
              </div>
              {%- if block.settings.image != blank -%}
                <div class="ex-selected__medium-image ex-art-slot">
                  {%- render 'responsive-image',
                    image: block.settings.image,
                    alt: block.settings.image_alt,
                    sizes: '(min-width: 750px) 32vw, 72vw',
                    widths: '360, 540, 720',
                    loading: 'lazy'
                  -%}
                </div>
              {%- endif -%}
            </article>

          {%- when 'typographic_trio' -%}
            <div class="ex-grid-12 ex-selected__trio" {{ block.shopify_attributes }}>
              {%- for i in (1..3) -%}
                {%- liquid
                  case i
                    when 1
                      assign num = block.settings.one_num
                      assign year = block.settings.one_year
                      assign title = block.settings.one_title
                      assign place = block.settings.one_place
                      assign works = block.settings.one_works
                      assign linked = block.settings.one_linked_works
                      assign suffix = block.settings.one_suffix
                    when 2
                      assign num = block.settings.two_num
                      assign year = block.settings.two_year
                      assign title = block.settings.two_title
                      assign place = block.settings.two_place
                      assign works = block.settings.two_works
                      assign linked = block.settings.two_linked_works
                      assign suffix = block.settings.two_suffix
                    when 3
                      assign num = block.settings.three_num
                      assign year = block.settings.three_year
                      assign title = block.settings.three_title
                      assign place = block.settings.three_place
                      assign works = block.settings.three_works
                      assign linked = block.settings.three_linked_works
                      assign suffix = block.settings.three_suffix
                  endcase
                -%}
                <article class="ex-selected__trio-item ex-selected__entry">
                  {%- render 'exhibitions-selected-pair-half',
                    num: num,
                    year: year,
                    title: title,
                    place: place,
                    title_class: 'ex-selected__entry-title--trio'
                  -%}
                  {%- render 'exhibitions-works-line', prefix: 'Shown:', works: works, linked_works: linked, suffix: suffix -%}
                </article>
              {%- endfor -%}
            </div>

          {%- when 'small_image' -%}
            <article
              class="ex-grid-12 ex-selected__small ex-selected__entry{% if block.settings.image == blank %} ex-selected__small--no-image{% endif %}"
              {{ block.shopify_attributes }}
            >
              <div class="ex-selected__small-text ex-selected__body">
                {%- render 'exhibitions-selected-entry-meta', block: block, title_class: 'ex-selected__entry-title--sm' -%}
              </div>
              {%- if block.settings.image != blank -%}
                <div class="ex-selected__small-image ex-art-slot">
                  {%- render 'responsive-image',
                    image: block.settings.image,
                    alt: block.settings.image_alt,
                    sizes: '(min-width: 750px) 22vw, 72vw',
                    widths: '280, 420, 560',
                    loading: 'lazy'
                  -%}
                </div>
              {%- endif -%}
            </article>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Exhibitions · Selected",
  "class": "exhibitions-selected-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Selected exhibitions"
    },
    {
      "type": "text",
      "id": "archive_link_label",
      "label": "Archive jump link",
      "default": "The full archive ↓"
    }
  ],
  "blocks": [
    {
      "type": "large_image",
      "name": "Large image entry",
      "settings": [
        { "type": "text", "id": "entry_num", "label": "Number", "default": "01" },
        { "type": "text", "id": "entry_year", "label": "Year", "default": "2026" },
        { "type": "text", "id": "title", "label": "Title", "default": "Devi" },
        {
          "type": "textarea",
          "id": "place",
          "label": "Venue and format",
          "default": "Blue House Too Gallery, Allen, Texas\nGroup exhibition"
        },
        {
          "type": "text",
          "id": "works",
          "label": "Works shown (comma-separated)",
          "default": "Devi – The Divine Feminine, Emergence"
        },
        { "type": "textarea", "id": "linked_works", "label": "Linked works (Title|/url per line)" },
        { "type": "image_picker", "id": "image", "label": "Artwork image" },
        { "type": "text", "id": "image_alt", "label": "Image alt" },
        { "type": "text", "id": "series_title", "label": "Series title (optional)" },
        { "type": "url", "id": "series_url", "label": "Series URL (optional)" }
      ]
    },
    {
      "type": "typographic_pair",
      "name": "Typographic pair",
      "settings": [
        { "type": "header", "content": "Left entry" },
        { "type": "text", "id": "left_num", "label": "Number", "default": "02" },
        { "type": "text", "id": "left_year", "label": "Year", "default": "2026" },
        { "type": "text", "id": "left_title", "label": "Title", "default": "Art in Arena" },
        {
          "type": "text",
          "id": "left_place",
          "label": "Place line",
          "default": "Frisco, Texas · Group exhibition"
        },
        { "type": "header", "content": "Right entry" },
        { "type": "text", "id": "right_num", "label": "Number", "default": "03" },
        { "type": "text", "id": "right_year", "label": "Year", "default": "2026" },
        { "type": "text", "id": "right_title", "label": "Title", "default": "Pink Revisited" },
        {
          "type": "text",
          "id": "right_place",
          "label": "Place line",
          "default": "theGallery8680, Frisco, Texas · Group exhibition"
        }
      ]
    },
    {
      "type": "medium_image",
      "name": "Medium image mirrored",
      "settings": [
        { "type": "text", "id": "entry_num", "label": "Number", "default": "04" },
        { "type": "text", "id": "entry_year", "label": "Year", "default": "2026" },
        { "type": "text", "id": "title", "label": "Title", "default": "Indulgence" },
        {
          "type": "textarea",
          "id": "place",
          "label": "Venue and format",
          "default": "Lincoln Center, Dallas, Texas\nGroup exhibition"
        },
        { "type": "text", "id": "works", "label": "Works shown", "default": "Indulgence" },
        {
          "type": "text",
          "id": "works_suffix",
          "label": "Suffix after works",
          "default": "which found its home during the exhibition."
        },
        { "type": "textarea", "id": "linked_works", "label": "Linked works (Title|/url per line)" },
        { "type": "image_picker", "id": "image", "label": "Artwork image" },
        { "type": "text", "id": "image_alt", "label": "Image alt" },
        { "type": "text", "id": "series_title", "label": "Series title (optional)" },
        { "type": "url", "id": "series_url", "label": "Series URL (optional)" }
      ]
    },
    {
      "type": "typographic_trio",
      "name": "Typographic trio",
      "settings": [
        { "type": "header", "content": "Entry 1" },
        { "type": "text", "id": "one_num", "label": "Number", "default": "05" },
        { "type": "text", "id": "one_year", "label": "Year", "default": "2024" },
        { "type": "text", "id": "one_title", "label": "Title", "default": "Abstract 2024" },
        { "type": "text", "id": "one_place", "label": "Place", "default": "VAGF, Sweetwaters, Frisco, Texas" },
        {
          "type": "text",
          "id": "one_works",
          "label": "Works",
          "default": "Yin and Yang – The Dark Side"
        },
        { "type": "textarea", "id": "one_linked_works", "label": "Linked works" },
        { "type": "text", "id": "one_suffix", "label": "Suffix" },
