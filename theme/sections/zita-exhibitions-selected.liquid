        },
        { "type": "textarea", "id": "linked_works", "label": "Linked works" },
        { "type": "image_picker", "id": "image", "label": "Artwork image" },
        { "type": "text", "id": "image_alt", "label": "Image alt" },
        { "type": "text", "id": "series_title", "label": "Series title (optional)" },
        { "type": "url", "id": "series_url", "label": "Series URL (optional)" }
      ]
